#!/bin/sh
# Flag the generated README files so local edits stay out of `git status`, and refuse to silently discard one.
#
# The two READMEs are generated by CI and committed by CI, so on a developer machine they are an output: running
# `pnpm readme` rewrites them, and GitHub's answers can make the result differ by a byte even when the plugin list did
# not change. Either would otherwise show up as a modified file that must not be committed by hand.
#
# `skip-worktree` is the right tool rather than `.gitignore`: an ignored path is untracked, and CI has to commit these
# files, so they must stay tracked. `skip-worktree` keeps them tracked while telling git to pretend the working copy is
# unmodified.
#
# The flag has a trap, and this script does not hide it: a flagged path cannot be staged at all, not even with `git add
# -f`, because the flag lives in the index rather than in the ignore list. A developer who edits a README without
# switching the hiding off would get a clean `git status`, a refused `git add`, and the edit silently overwritten by the
# next checkout. So a copy that differs from the index is reported and left alone instead of being restored, and the
# edit survives until the developer either switches the hiding off to commit it or discards it by hand.
#
# Run by .githooks/post-checkout and .githooks/post-merge, so a fresh clone and every pull both get it without the
# developer having to know it exists.
#
# Two things switch it off. `SKIP_README_WORKTREE=1` opts a single invocation out, which is what the CI workflow sets,
# because the commit step has to stage the file. A hand edit uses `.githooks/generated-readme off`, which is the same
# switch kept off until turned back on.
set -eu

if [ "${SKIP_README_WORKTREE:-0}" = '1' ]; then
  exit 0
fi

# A CI checkout is not a developer machine and must never be flagged.
if [ "${CI:-}" = 'true' ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root"

# A hand edit turns the hiding off through `.githooks/generated-readme off`. While it is off the working copy is meant to
# differ, so nothing here applies.
if [ -e "$(git rev-parse --git-dir)/generated-readme-off" ]; then
  exit 0
fi

drift=''
for file in README.md README.zh.md; do
  # `git ls-files -v` marks a flagged path with a leading `S`; an unflagged one is not managed here and is left alone.
  case $(git ls-files -v -- "$file" 2>/dev/null) in
    S*) ;;
    *) continue ;;
  esac
  # Compare the blob the index holds with the blob the file would produce. `git diff` cannot be used: it reports a
  # skip-worktree path as unmodified by design, which is the whole point of the flag, so it would never notice the drift
  # this check exists to report.
  indexed=$(git rev-parse --verify --quiet ":$file") || continue
  current=$(git hash-object -- "$file" 2>/dev/null) || continue
  if [ "$indexed" != "$current" ]; then
    drift="$drift $file"
  fi
done

# Report in the language the user reads, not only in English. git itself uses gettext for this, but that needs the
# gettext toolchain installed and a compiled catalogue shipped with the repository, which is a lot of machinery for three
# lines. The strings are short and fixed, so they are inlined: `LC_ALL` wins over `LC_MESSAGES` and `LANG`, as gettext
# does, and anything that is not Chinese falls back to English.
lang=${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}
case $lang in
  zh_* | *_CN* | *_cn*) chinese=1 ;;
  *) chinese='' ;;
esac

if [ -n "$drift" ]; then
  # Left untouched on purpose. Restoring would destroy an edit that the developer may have been about to commit, and the
  # refusal to stage it is what a hand edit has to be told about, not a file that quietly reverts.
  if [ -n "$chinese" ]; then
    printf '%s\n' "generated-readme: 保留了本地修改：$drift" >&2
    printf '%s\n' '  隐藏开启时这些修改无法提交。提交请先运行 `.githooks/generated-readme off`，' >&2
    printf '%s\n' '  丢弃修改并恢复成已提交的版本请运行 `.githooks/generated-readme reset`。' >&2
  else
    printf '%s\n' "generated-readme: local edits kept in$drift" >&2
    printf '%s\n' '  they cannot be committed while hiding is on; run `.githooks/generated-readme off` to commit them,' >&2
    printf '%s\n' '  or `.githooks/generated-readme reset` to discard them and match the committed copy' >&2
  fi
  exit 0
fi

GENERATED_README_QUIET=1 exec "$root/.githooks/generated-readme" on
