#!/bin/sh
# Hide local edits to the generated README files from `git status`, without untracking them.
#
# The two READMEs are generated by CI and committed by CI, so on a developer machine they are an output: running
# `pnpm readme` rewrites them, and GitHub's answers can make the result differ by a byte even when the plugin list did
# not change. Either would otherwise show up as a modified file that must not be committed by hand.
#
# `skip-worktree` is the right tool rather than `.gitignore`: an ignored path is untracked, and CI has to commit these
# files, so they must stay tracked. `skip-worktree` keeps them tracked while telling git to pretend the working copy is
# unmodified. `assume-unchanged` would work too but it is a promise about performance that some operations clear;
# `skip-worktree` is the one that means "the working copy is not the source of truth".
#
# Run by .githooks/post-checkout and .githooks/post-merge, so a fresh clone and every pull both get it without the
# developer having to know it exists.
#
# Two things switch it off. `SKIP_README_WORKTREE=1` opts a single invocation out, which is what the CI workflow sets,
# because `skip-worktree` also makes `git add` refuse the path and the commit step has to stage it. A hand edit uses
# `.githooks/generated-readme off`, which is the same switch kept off until turned back on.
set -eu

if [ "${SKIP_README_WORKTREE:-0}" = '1' ]; then
  exit 0
fi

# A CI checkout is not a developer machine and must never be flagged.
if [ "${CI:-}" = 'true' ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# A hand edit turns the hiding off through `.githooks/generated-readme off`, and that has to survive the checkout and pull
# that may happen while the edit is in progress. The marker is what remembers it.
if [ -e "$(git rev-parse --git-dir)/generated-readme-off" ]; then
  exit 0
fi

exec "$root/.githooks/generated-readme" on
